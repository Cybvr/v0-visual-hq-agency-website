rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function clientId() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId; }
    function owns(data) { return signedIn() && data.clientId == clientId(); }
    function visibleProject(projectId) {
      return signedIn() && get(/databases/$(database)/documents/portalProjects/$(projectId)).data.clientId == clientId();
    }
    function visibleTask(taskId) {
      let task = get(/databases/$(database)/documents/portalTasks/$(taskId)).data;
      return owns(task) && visibleProject(task.projectId);
    }
    function assignedTask(taskId) {
      let task = get(/databases/$(database)/documents/portalTasks/$(taskId)).data;
      return visibleTask(taskId) && task.assigneeUid == request.auth.uid;
    }
    function completionOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['todo', 'done']
        && request.resource.data.updatedAt == request.time;
    }

    match /portfolio/{id} { allow read: if true; allow write: if isAdmin(); }
    match /jpportfolio/{id} { allow read: if true; allow write: if isAdmin(); }
    match /organizations/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read, write: if isAdmin(); }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'client' && request.resource.data.clientId == uid);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.clientId == resource.data.get('clientId', uid));
      allow delete: if isAdmin();
    }

    // Agency source documents stay private, apart from existing marketing publications.
    match /projects/{id} {
      allow read: if isAdmin() || resource.data.get('isPublic', false) == true
        || (resource.data.get('isCaseStudy', false) == true && resource.data.get('caseStudyStatus', '') == 'published');
      allow write: if isAdmin();
    }
    match /tasks/{id} {
      allow read: if isAdmin() || resource.data.get('isPublic', false) == true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (owns(resource.data) && assignedTask(id) && completionOnly()
        && getAfter(/databases/$(database)/documents/portalTasks/$(id)).data.status == request.resource.data.status);
    }

    // Deliberately published, allowlisted client views; no internal note fields.
    match /portalProjects/{id} {
      allow read: if isAdmin() || owns(resource.data);
      allow write: if isAdmin();
    }
    match /portalTasks/{id} {
      allow read: if isAdmin() || (owns(resource.data) && visibleProject(resource.data.projectId));
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (owns(resource.data) && visibleProject(resource.data.projectId)
        && resource.data.assigneeUid == request.auth.uid && completionOnly()
        && getAfter(/databases/$(database)/documents/tasks/$(id)).data.status == request.resource.data.status);
    }

    // Existing task discussions are agency notes. Portal feedback has its own collection.
    match /comments/{id} { allow read, write: if isAdmin(); }
    match /portalComments/{id} {
      allow read: if isAdmin() || (owns(resource.data) && visibleTask(resource.data.taskId));
      allow create: if isAdmin() || (owns(request.resource.data) && visibleTask(request.resource.data.taskId)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['clientId', 'taskId', 'authorUid', 'authorName', 'body', 'createdAt'])
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 4000
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 200
        && request.resource.data.createdAt == request.time);
      allow update, delete: if isAdmin();
    }

    match /documents/{id} {
      allow read: if isAdmin() || owns(resource.data)
        || (signedIn() && request.auth.uid in resource.data.get('sharedWithUserIds', []));
      allow write: if isAdmin();
    }

    // Keep legacy single-document links. Anonymous collection browsing is closed.
    match /invoices/{id} {
      allow get: if isAdmin() || resource.data.status != 'draft';
      allow list: if isAdmin() || (owns(resource.data) && resource.data.status != 'draft');
      allow write: if isAdmin();
    }
    match /contracts/{id} {
      allow get: if isAdmin() || resource.data.status != 'draft';
      allow list: if isAdmin() || (owns(resource.data) && resource.data.status != 'draft');
      allow write: if isAdmin();
    }
    match /estimates/{id} {
      allow get: if isAdmin() || (resource.data.status != 'draft' && (owns(resource.data) || resource.data.get('shareEnabled', false) == true));
      allow list: if isAdmin() || (owns(resource.data) && resource.data.status != 'draft');
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || ((owns(resource.data) || resource.data.get('shareEnabled', false) == true)
        && resource.data.status == 'sent' && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'updatedAt']));
    }
    // No client approval UI currently uses this legacy collection.
    match /approvals/{id} { allow read, write: if isAdmin(); }

    // One conversation transcript per signed-in account. The agent stores no
    // portal records here; this is only the user's own chat history.
    match /agentConversations/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /chats/{chatId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
