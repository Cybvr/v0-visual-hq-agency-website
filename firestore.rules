rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Reads the caller's own users/{uid} doc to check their role.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // -----------------------------------------------------------------------
    // NOTE: The previous open catch-all
    //   match /{collection}/{document=**} { allow read, write: if request.auth != null; }
    // let ANY signed-in user read/write EVERY collection. That broke client
    // isolation (a client could read other clients' data), so it is removed.
    // Access is now granted per-collection below. Anything without a matching
    // rule is denied by default.
    // -----------------------------------------------------------------------

    // Portfolio - public site content. Public read; writes admin-only.
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // JPPortfolio - public read; writes admin-only.
    match /jpportfolio/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Documents - admins manage; clients read documents shared with them,
    // their client workspace, or their explicit user id.
    match /documents/{documentId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.clientId == myClientId()
        || request.auth.uid in resource.data.get('sharedWithUserIds', [])
      ));
      allow write: if isAdmin();
    }

    // Users - clients can manage their own profile, but cannot change their
    // role or move themselves into another client's workspace.
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdmin() || (isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'client'
        && request.resource.data.clientId == userId);
      allow update: if isAdmin() || (isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.clientId == resource.data.clientId);
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Reads the caller's users/{uid} doc to get their clientId.
    function myClientId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId;
    }

    // Projects - admins manage; clients can read and create projects only in
    // their own workspace. A project with isPublic true is a template. A
    // published isCaseStudy project is readable on the public marketing site.
    // Clients can update their own projects, which is how they publish one,
    // but they cannot hand it to another workspace.
    match /projects/{projectId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.clientId == myClientId())
        || resource.data.isPublic == true
        || (resource.data.isCaseStudy == true && resource.data.caseStudyStatus == 'published');
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.clientId == myClientId());
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.clientId == myClientId()
            && request.resource.data.clientId == resource.data.clientId);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.clientId == myClientId());
    }

    // Tasks - admins manage all; a client has full CRUD on their OWN tasks
    // (clientId must match, and an update can't move a task to another client).
    // Tasks carrying isPublic true are the steps of a published template and
    // are readable by anyone, so the templates page can list the workflow.
    match /tasks/{taskId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.clientId == myClientId())
        || resource.data.isPublic == true;
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.clientId == myClientId());
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.clientId == myClientId()
            && request.resource.data.clientId == resource.data.clientId);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.clientId == myClientId());
    }

    // Comments - the thread on a task. Anyone signed in who can reach the task's
    // workspace can read and post; a comment carries its author, and only that
    // author or an admin can remove it. Comments are never public, so a template's
    // thread stays with the workspace that wrote it.
    match /comments/{commentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.clientId == myClientId());
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // Finance records - admins manage all. Issued invoices and contracts are
    // listed on public company pages; drafts remain internal. Estimates retain
    // their explicit per-record share toggle.
    match /invoices/{invoiceId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.clientId == myClientId() && resource.data.status != 'draft')
        || resource.data.status != 'draft';
      allow write: if isAdmin();
    }

    match /contracts/{contractId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.clientId == myClientId() && resource.data.status != 'draft')
        || resource.data.status != 'draft';
      allow write: if isAdmin();
    }

    match /estimates/{estimateId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.clientId == myClientId() && resource.data.status != 'draft')
        || resource.data.shareEnabled == true;
      allow write: if isAdmin();
    }

    // Organizations - the company a client user belongs to (see lib/organizations.ts).
    // Doc id is the same clientId used everywhere else. Public read: this also
    // backs each company's public page at visualcns.com/{organization.slug} -
    // only name/logo/industry/location/website live here, nothing sensitive.
    // Writes remain admin-only.
    match /organizations/{organizationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings - single-doc site config (see lib/business-profile.ts: the
    // "Prepared by" issuer info printed on invoices/estimates/contracts).
    // Public read: it's shown on unauthenticated /share/{invoices,estimates,
    // contracts} pages. Writes remain admin-only.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Approvals - client deliverable sign-off (see lib/approvals.ts).
    // Signed-in users can read/write; admins included. Tighten to per-client
    // once approvals carry a clientId you can match against the user doc.
    match /approvals/{approvalId} {
      allow read, write: if isSignedIn();
    }

    // Everything else: denied by default.
  }
}
